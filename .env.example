# Celery Task Queue — environment template. Copy to `.env` and edit.
# NEVER commit your real .env file.

# Broker (message transport). Redis by default; RabbitMQ also works.
CELERY_BROKER_URL=redis://localhost:6379/0

# Result backend (where task return values are stored).
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Run tasks inline in the calling process — no broker/worker needed.
# Set to "true" for tests / local experiments; keep "false" in production.
CELERY_TASK_ALWAYS_EAGER=false
